@page "{id:int}"
@model AccountMenuModel
@{
    ViewData["Title"] = "Account Menu";
}

<h1>Account Details</h1>
<div id="accountContainer">


<div id="accountHeader">
    <p>Account #@Model.Account.Id</p>
    <p id="accountBalance">Balance: @Model.Account.Balance.ToString("C")</p>
</div>

<div id="nickname">
    <p>Nickname:</p>
    <div id="nicknameContainer">
        <input value="NEED NICKNAME FUNCTION" id="nicknameInput"></input> 
        <button id="nicknameButton" class="btn btn-primary">Update Nickname</button>
    </div>
</div>

<div id="accountActions">
    <div id="depositContainer">
        <p id="depositFunds">Deposit Funds</p>
        <form method="post" asp-page-handler="Deposit" class="accountActoinsForm">
            <label for="depositAmount">$</label>
            <input type="number" name="depositAmount" placeholder="Amount" required />
            <button type="button" class="btn btn-primary" id="depositFundsBtn" onclick="handleDeposit(@Model.Account.Id)">Deposit</button>
        </form>
    </div>

    <div id="withdrawContainer">
        <p id="withdrawFunds">Withdraw Funds</p>
        <form method="post" asp-page-handler="Withdraw" class="accountActoinsForm">
            <label for="withdrawAmount">$</label>
            <input type="number" name="withdrawAmount" placeholder="Amount" required />
            <button type="button" class="btn btn-primary" id="withdrawFundsBtn" onclick="handleWithdraw(@Model.Account.Id)">Withdraw</button>
        </form>
    </div>
</div>

<div id="transactionHistory">
    <h2>Transaction History</h2>
    <table class="table table-striped table-bordered">
        <thead>
            <tr>
                <th>Date</th>
                <th>Type</th>
                <th>Amount</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Account.Transactions != null && Model.Account.Transactions.Any())
            {
                foreach (var transaction in Model.Account.Transactions)
                {
                    <tr>
                        <td>@transaction.Date.ToString("MM/dd/yyyy")</td>
                        <td>@transaction.Type</td>
                        <td>@transaction.Amount.ToString("C")</td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="4">No transactions available.</td>
                </tr>
            }
        </tbody>
    </table>
</div>

<div id="deleteAccountContainer">
    <button id="deleteAccountButton" class="btn btn-danger" onclick="handleDelete(@Model.Account.Id)">🗑 Delete Account</button>
</div>



<script>
    async function handleDeposit(accountId) {
        const amount = document.querySelector('input[name="depositAmount"]').value;
        if (!amount || amount <= 0) {
            alert("Please enter a valid deposit amount.");
            return;
        }

        try {
            const response = await fetch(`http://localhost:1234/deposit/${accountId}/${amount}`, {
                method: 'POST'
            });

            if (response.ok) {
                location.reload(); // Reload the page to update the balance
            } else {
                console.log(response);
                const error = await response.text();
                alert(`Error 1: ${error}`);
            }
        } catch (err) {
            console.error(err);
            alert("An error occurred while processing the deposit.");
        }
    }

    async function handleWithdraw(accountId) {
        const amount = document.querySelector('input[name="withdrawAmount"]').value;
        if (!amount || amount <= 0) {
            alert("Please enter a valid withdrawal amount.");
            return;
        }

        try {
            const response = await fetch(`http://localhost:1234/withdraw/${accountId}/${amount}`, {
                method: 'POST'
            });

            if (response.ok) {
                location.reload(); // Reload the page to update the balance
            } else {
                const error = await response.text();
                alert(`Error 1: ${error}`);
            }
        } catch (err) {
            console.error(err);
            alert("An error occurred while processing the withdrawal.");
        }
    }
    async function handleDelete(accountId) {
        if (confirm("Are you sure you want to delete this account? This action cannot be undone.")) {
            try {
                const response = await fetch(`http://localhost:1234/account/${accountId}`, {
                    method: 'DELETE'
                });

                if (response.ok) {
                    window.location.href = '/'; // Redirect to home page or accounts list
                } else {
                    const error = await response.text();
                    alert(`Error 1: ${error}`);
                }
            } catch (err) {
                console.error(err);
                alert("An error occurred while deleting the account.");
            }
        }
    }
</script>