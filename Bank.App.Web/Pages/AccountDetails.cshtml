@page "{id:int}"
@model AccountDetailsModel
@{
    ViewData["Title"] = "Account Details";
}
<h2>Account Details</h2>
<div>
    <p><strong>Account ID:</strong> @Model.Account.Id</p>
    <p><strong>Balance:</strong> @Model.Account.Balance.ToString("C")</p>
</div>

<h3>Deposit</h3>
<form method="post" asp-page-handler="Deposit">
    <div class="form-group">
        <label>Amount:</label>
        <input type="number" step="0.01" name="DepositAmount" class="form-control" required />
    </div>
    <button type="submit" class="btn btn-success">Deposit</button>
</form>

<h3>Withdraw</h3>
<form method="post" asp-page-handler="Withdraw">
    <div class="form-group">
        <label>Amount:</label>
        <input type="number" step="0.01" name="WithdrawAmount" class="form-control" required />
    </div>
    <button type="submit" class="btn btn-warning">Withdraw</button>
</form>

<h3>Delete Account</h3>
<form method="post" asp-page-handler="Delete" onsubmit="return confirm('Are you sure you want to delete this account?');">
    <button type="submit" class="btn btn-danger">Delete Account</button>
</form>

<h3>Transaction History</h3>
@if(Model.Account.Transactions != null && Model.Account.Transactions.Any())
{
    <table class="table table-bordered">
        <thead>
            <tr>
                <th>Date</th>
                <th>Type</th>
                <th>Amount</th>
            </tr>
        </thead>
        <tbody>
            @foreach(var txn in Model.Account.Transactions)
            {
                <tr>
                    <td>@txn.Date.ToString("g")</td>
                    <td>@txn.Type</td>
                    <td>@txn.Amount.ToString("C")</td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <p>No transactions found.</p>
}
