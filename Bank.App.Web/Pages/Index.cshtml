@page
@model IndexModel
@{
    ViewData["Title"] = "Bank App";
}

<h1>Bank Accounts</h1>


@if (Model.SelectedAccount == null)
{
    <table class="table">
        <thead>
            <tr>
                <th>ID</th>
                <th>Balance</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var account in Model.Accounts)
            {
                <tr>
                    <td>@account.Id</td>
                    <td>@account.Balance.ToString("C")</td>
                    <td>
                        <form method="post" asp-page-handler="SelectAccount">
                            <input type="hidden" name="id" value="@account.Id" />
                            <button type="submit" class="btn btn-primary">Open</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <form method="post" asp-page-handler="CreateAccount">
        <button type="submit" class="btn btn-success">Create New Account</button>
    </form>
}
else
{
    <h2>Account ID: @Model.SelectedAccount.Id</h2>
    <p>Balance: @Model.SelectedAccount.Balance.ToString("C")</p>

    <form method="post" asp-page-handler="Deposit">
    <input type="hidden" name="SelectedAccountId" value="@Model.SelectedAccount?.Id" />
    <input type="number" name="amount" placeholder="Enter amount" required />
    <button type="submit" class="btn-success btn-lg">Deposit</button>
    </form>

    <form method="post" asp-page-handler="Withdraw">
    <input type="hidden" name="SelectedAccountId" value="@Model.SelectedAccount?.Id" />
    <input type="number" name="amount" placeholder="Enter amount" required />
    <button type="submit" class="btn-warning btn-lg">Withdraw</button>
    </form>

    <form method="post" asp-page-handler="DeleteAccount">
    <input type="hidden" name="SelectedAccountId" value="@Model.SelectedAccount?.Id" />
    <button type="submit" class="btn btn-danger">Delete Account</button>
    </form>

    <h3>Transactions</h3>
    @if (Model.SelectedAccount.Transactions.Any())
    {
        <table class="table">
            <thead>
                <tr>
                    <th>Date</th>
                    <th>Type</th>
                    <th>Amount</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var transaction in Model.SelectedAccount.Transactions)
                {
                    <tr>
                        <td>@transaction.Date.ToString("g")</td>
                        <td>@transaction.Type</td>
                        <td>@transaction.Amount.ToString("C")</td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <p>No transactions found.</p>
    }

    <form method="post" asp-page-handler="Back">
        <button type="submit" class="btn btn-secondary">Back</button>
    </form>
}
