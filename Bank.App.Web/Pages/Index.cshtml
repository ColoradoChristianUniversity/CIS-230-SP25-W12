@page
@model IndexModel
@{
    ViewData["Title"] = "Accounts";
}

<h2>Accounts</h2>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Account ID</th>
            <th>Balance</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
    @foreach(var account in Model.Accounts)
    {
        <tr>
            <td>@account.Id</td>
            <td>@account.Balance.ToString("C")</td>
            <td>
                <a asp-page="/AccountDetails" asp-route-id="@account.Id" class="btn btn-primary">View</a>
            </td>
        </tr>
    }
    </tbody>
</table>

<a asp-page="/CreateAccount" class="btn btn-success">Create New Account</a>
